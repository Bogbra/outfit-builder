# Server-only — used by Server Components (e.g. the catalog page fetch).
API_URL="http://localhost:8080"
# Inlined into the browser bundle — used by Client Components (e.g. the
# save/delete outfit REST calls), since API_URL is not readable there.
NEXT_PUBLIC_API_URL="http://localhost:8080"
# Read directly in src/proxy.ts (not through src/lib/env.ts) to redirect
# unauthenticated /admin requests — a UX convenience only, apps/api
# independently re-verifies every admin request itself. Must match
# apps/api's AUTH_SECRET exactly. See apps/api/.env.example for how to
# generate a real one.
AUTH_SECRET="replace-me-with-output-of-openssl-rand-base64-32"
