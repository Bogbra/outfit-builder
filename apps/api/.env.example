DATABASE_URL="postgresql://user:password@localhost:5433/outfit_builder"
# Signs and verifies admin session JWTs (apps/api and apps/web must use the
# same value). Must be at least 32 characters. Generate a real one with:
# openssl rand -base64 32
# The value below is long enough to boot locally, but is a published
# example, not a secret — replace it before anything beyond casual local
# testing.
AUTH_SECRET="replace-me-with-output-of-openssl-rand-base64-32"
ADMIN_EMAIL="admin@example.com"
# bcrypt hash of the admin password — never store the plaintext password.
# The hash below is for the example password "changeme-admin-password",
# so you can log in locally without generating your own first. Generate
# your own with (run from the repo root; bcryptjs is only a dependency of
# apps/api, so plain `node -e` won't resolve it):
# pnpm --filter api exec node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH="$2a$10$ws4PawZyUhwjUiCeiT6zeu8sQ1QFxYwxTtzeVUYH45O6lhjd3U1Fq"
# The web app's own public origin — only read here, for the API's CORS
# allow-origin (apps/web itself never reads this var).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
# fashn.ai virtual try-on API key — never exposed to the browser. Get one at
# https://fashn.ai. Real cost per generation; the outfit "try it on" feature
# chains up to 3 calls per request (top/bottom/jacket — see
# TRY_ON_ELIGIBLE_CATEGORIES in packages/contracts). Left commented out on purpose: unlike
# the values above, there's no safe placeholder here — any non-empty string
# is treated as a real key and used to call fashn.ai. Leave this line
# commented out to run everything else; the try-on feature then returns 503
# instead of the API failing to boot or making a real (failing) upstream call.
# FASHN_API_KEY="your-real-fashn-ai-key"
# Separate, stricter rate limit for try-on requests — real money per
# request against a third-party API.
TRYON_RATE_LIMIT_WINDOW_SECONDS=3600
TRYON_RATE_LIMIT_MAX_REQUESTS=5
# Looser limit for polling try-on status — legitimate polling happens every
# 2s, but each poll can still trigger a paid provider call.
TRYON_STATUS_RATE_LIMIT_WINDOW_SECONDS=600
TRYON_STATUS_RATE_LIMIT_MAX_REQUESTS=120
# Per-client request budget for /graphql — graphql-armor limits how
# expensive one query can be, this limits how many a client can send.
GRAPHQL_RATE_LIMIT_WINDOW_SECONDS=60
GRAPHQL_RATE_LIMIT_MAX_REQUESTS=120
