DATABASE_URL="postgresql://user:password@localhost:5433/outfit_builder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:8080"
# Client components run in the browser and cannot read API_URL (it is not
# NEXT_PUBLIC_-prefixed). Used for the save/delete outfit REST calls.
NEXT_PUBLIC_API_URL="http://localhost:8080"
# Signs and verifies admin session JWTs (apps/api and apps/web must use the
# same value). Generate a real one with: openssl rand -base64 32
AUTH_SECRET="replace-me"
ADMIN_EMAIL="admin@example.com"
# bcrypt hash of the admin password — never store the plaintext password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH="replace-me-with-a-bcrypt-hash"
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
# fashn.ai virtual try-on API key (apps/api only — never exposed to the
# browser). Get one at https://fashn.ai. Real cost per generation; the
# outfit "try it on" feature chains up to 6 calls per request. Optional —
# the feature returns 503 rather than the whole API failing to boot if unset.
FASHN_API_KEY="replace-me"